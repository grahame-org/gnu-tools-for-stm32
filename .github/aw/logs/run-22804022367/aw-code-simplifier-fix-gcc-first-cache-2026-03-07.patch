From 3f25c648ec1318a97a3f76a8ae27dd12641deb07 Mon Sep 17 00:00:00 2001
From: Copilot <copilot@github.com>
Date: Sat, 7 Mar 2026 17:52:07 +0000
Subject: [PATCH] =?UTF-8?q?ci:=20add=20merge=5Fgroup=20guard=20to=20Save?=
 =?UTF-8?q?=20cache=20=E2=80=93=20gcc-first=20step?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

All other Save cache steps in build-toolchain.yml include
`&& github.event_name != 'merge_group'` in their if: condition
to avoid polluting the cache during merge queue runs.
The gcc-first step added in PR #161 was missing this guard.

Also fix a cosmetic double-space in build-gcc-first.sh line 129
(`rm -rf  include` → `rm -rf include`).

Co-authored-by: Copilot <223556219+Copilot@users.noreply.github.com>
---
 .github/workflows/build-toolchain.yml | 2 +-
 build-gcc-first.sh                    | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/.github/workflows/build-toolchain.yml b/.github/workflows/build-toolchain.yml
index 310764a82..b1da6ec52 100644
--- a/.github/workflows/build-toolchain.yml
+++ b/.github/workflows/build-toolchain.yml
@@ -229,7 +229,7 @@ jobs:
             --skip_steps=mingw,mingw-gdb-with-python,gdb-with-python,manual,package_sources
 
       - name: Save cache – gcc-first
-        if: steps.cache-gcc-first.outputs.cache-hit != 'true' && steps.cache-toolchain.outputs.cache-hit != 'true'
+        if: steps.cache-gcc-first.outputs.cache-hit != 'true' && steps.cache-toolchain.outputs.cache-hit != 'true' && github.event_name != 'merge_group'
         uses: actions/cache/save@cdf6c1fa76f9f475f3d7449005a359c84ca0f306 # v5.0.3
         with:
           path: install-native
diff --git a/build-gcc-first.sh b/build-gcc-first.sh
index fda280113..9411b7721 100755
--- a/build-gcc-first.sh
+++ b/build-gcc-first.sh
@@ -126,6 +126,6 @@ if [ "x$skip_native_build" != "xyes" ] ; then
     pushd $INSTALLDIR_NATIVE
     rm -rf bin/arm-none-eabi-gccbug
     rm -rf ./lib/libiberty.a
-    rm -rf  include
+    rm -rf include
     popd
 fi
-- 
